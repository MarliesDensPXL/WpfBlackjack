<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack"
        mc:Ignorable="d"
        Title="♥ ♦ ♠ ♣ Blackjack ♥ ♦ ♠ ♣" Height="800" Width="1200" ResizeMode="NoResize" FontSize="18" Foreground="White" >

    <Window.Background>
        <ImageBrush ImageSource="/Images/blackjack-background.png"/>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="Transparent" />
            </LinearGradientBrush>
        </Grid.Background>

        <GroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Header="Game" Margin="5">
            <StackPanel>
                <Button Content="New Game" Margin="10" Background="Green"/>
                <Separator/>
                <TextBlock Text="Credits:" Margin="10"/>
                <TextBlock Text="500" HorizontalAlignment="Right" FontSize="28" Margin="10"/>
                
            </StackPanel>           
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Bank" Margin="5">
            <StackPanel Orientation="Horizontal" x:Name="bankStack" Margin="5" Width="910" Height="170">

            </StackPanel>

        </GroupBox>        
        <Grid Grid.Row="1" Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="4*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="resultGrid" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" />
                <Button Grid.Row="1" x:Name="newRoundButton" Content="Next" HorizontalAlignment="Right" Background="Green" Width="150" Margin="10"/>
                <Button Grid.Row="1" x:Name="stopGameButton" Content="Stop" HorizontalAlignment="Left" Background="Red" Width="150" Margin="10"/>
            </Grid>
            <StackPanel Grid.Column="0" Grid.Row="1" x:Name="playerBetPanel" Orientation="Vertical" Margin="5" >
                <TextBlock Text="Place your bet" HorizontalAlignment="Center" Width="120" Margin="10"/>
                <TextBox Background="White" Margin="10" Width="120"/>
                <Button Content="Play" Background="Green" x:Name="playButton" Width="120" Visibility="Visible" Margin="10"/>
            </StackPanel>
            
            <Image Grid.Column="1" Grid.Row="1" Source="/Images/back.png" Margin="10"/>
            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="remainingCardsTextBlock" Text="52" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48"/>
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="bankPointsTextBlock" HorizontalAlignment="Right" Text="0" FontSize="28" Margin="10"/>
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="playerPointsTextBlock" HorizontalAlignment="Right" Text="0" FontSize="28" Margin="10"/>
            <Grid Grid.Row="2" Grid.Column="1"  x:Name="actionsGrid" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="cardButton" Content="Card" Background="Green" Margin="5"/>
                <Button Grid.Column="1" x:Name="stopButton" Content="Stop" Background="Red" Margin="5"/>

            </Grid>          
            
            
        </Grid>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Player" Margin="5">
            <StackPanel Orientation="Horizontal" x:Name="playerStack" Margin="5" Width="910" Height="170">

            </StackPanel>

        </GroupBox>

    </Grid>
</Window>

