<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack"
        mc:Ignorable="d"
        Title="♥ ♦ ♠ ♣ Blackjack ♥ ♦ ♠ ♣" Height="800" Width="1200" ResizeMode="NoResize" FontSize="18" Foreground="White" >

    <Window.Background>
        <ImageBrush ImageSource="/Images/blackjack-background.png"/>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="Transparent" />
            </LinearGradientBrush>
        </Grid.Background>

        <GroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Header="Game">
            <StackPanel>
                <Button Content="New Game" />
                <Separator/>
                <TextBlock Text="Credits:"/>
                <TextBlock Text="500"/>
                
            </StackPanel>           
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.Column="1" Header="Bank">
            <StackPanel x:Name="bankStack"/>

        </GroupBox>        
        <Grid Grid.Row="1" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Place your bet" Margin="10"/>
                <TextBox Background="White" Margin="10"/>
                <Button Content="Play" Background="Green" x:Name="playButton" Visibility="Visible" Margin="10"/>
            </StackPanel>
            <StackPanel x:Name="playerBetPanel" Grid.Column="1">
                <Grid>
                    <Image Source="/Images/back.png" Margin="10"/>
                    <TextBlock x:Name="remainingCardsTextBlock" Text="52" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48"/>
                </Grid>                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="cardButton" Content="Card" Background="Green" Margin="10"/>
                    <Button Grid.Column="1" x:Name="stopButton" Content="Stop" Background="Red" Margin="10"/>

                </Grid>
            </StackPanel>
            <DockPanel x:Name="resultPanel" Margin="5">
                <TextBlock DockPanel.Dock="Top" x:Name="bankPointsTextBlock" Text="0" Margin="10"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="playerPointsTextBlock" Text="0" Margin="10"/>
            </DockPanel>
            
            
        </Grid>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Player">
            <StackPanel x:Name="playerStack"/>
        </GroupBox>

    </Grid>
</Window>

